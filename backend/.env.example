# Copy this file to ".env" in the same folder and fill in real values.
# Never commit the real .env file.

# --- Database ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=cartiva

# --- Session ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Server ---
PORT=3000

# Set to "production" when deploying. Enables secure cookies and disables
# the dev-only password-reset link shortcut.
NODE_ENV=development

# Optional: restrict CORS to a specific frontend origin instead of
# reflecting the request origin. Leave blank for local development.
CORS_ORIGIN=
